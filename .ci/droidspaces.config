# Droidspaces / Docker-in-container kernel fragment
# Target: crux-marisa A16 (4.14.357-openela), defconfig: crux_defconfig
# Reference: Droidspaces-OSS Documentation/Kernel-Configuration.md (non-GKI 3.18~4.19 path)
#
# v14 changes vs v13:
#   + BRIDGE_NETFILTER, NETFILTER_ADVANCED  (the bug the report caught: modprobe br_netfilter)
#   + SYSVIPC, NAMESPACES, FAIR_GROUP_SCHED, CGROUP_NET_PRIO, TMPFS_POSIX_ACL
#   + FW_LOADER_USER_HELPER, BLK_DEV_LOOP, EXT4_FS
#   + XT_TARGET_TCPMSS, XT_MATCH_ADDRTYPE, NF_NAT_REDIRECT, NF_CONNTRACK_NETLINK
#   + IP_ADVANCED_ROUTER, IP_MULTIPLE_TABLES, IPV6_MULTIPLE_TABLES, IP6_NF_FILTER
#   + legacy compat: NF_CONNTRACK_IPV4/IPV6, NF_NAT_IPV4/IPV6
#   + firewall/UFW/fail2ban full set (Step 2 of the doc)
# 4.14 symbol-name mapping (verified against this tree's Kconfig files):
#   CONFIG_NETFILTER_XT_TARGET_MASQUERADE -> this tree ships NF_NAT_MASQUERADE_IPV4/IPV6
#     (the generic symbol only exists from 4.18; IP_NF_TARGET_MASQUERADE covers it here)
#   CONFIG_NF_CONNTRACK_NETLINK -> NF_CT_NETLINK (renamed in 4.15)
#   CONFIG_NFT_CHAIN_NAT        -> NFT_CHAIN_NAT_IPV4 / NFT_CHAIN_NAT_IPV6
#     (both need NF_TABLES_IPV4 / NF_TABLES_IPV6, now enabled explicitly)
#   CONFIG_IP_NF_TARGET_ULOG    -> does not exist in this tree at all (dropped)
#   CONFIG_FW_LOADER_COMPRESS   -> does not exist anywhere in 4.14 (added in 5.3) — dropped

# --- IPC mechanisms (doc: required) ---
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Namespaces (FHANDLE forced off in crux_defconfig; fragment cannot express =n) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- Cgroups v1 controllers needed by droidspaces/docker/lxc ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
# CONFIG_CGROUP_NET_PRIO is not set — 4.14 REMOVED struct cgroup.id, but
# include/net/netprio_cgroup.h still dereferences css->cgroup->id. The driver is
# stale against its own tree and fails to compile (proved by Run #50:
# "../include/net/netprio_cgroup.h:35:21: error: no member named 'id'").
# It is also absent from stock crux (v1_config: "# CONFIG_CGROUP_NET_PRIO is not set").
# Droidspaces' requirements doc lists it, but it is only used for net_prio
# socket priority, which no container feature depends on.
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
# NOTE: CFS_BANDWIDTH stays OFF — vendor SCHED_WALT hard-excludes it.
# Consequence: --cpus is skipped with a warning (documented limitation).
# CONFIG_CFS_BANDWIDTH is not set

# --- Filesystem / rootfs ---
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_FUSE_FS=y

# --- Firmware loading (4.14: no FW_LOADER_COMPRESS) ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Networking: base + bridge/NAT (doc Step 1, the required block) ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CHAIN_NAT_IPV4=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_NET_CLS_CGROUP=y

# --- IPv6 / NAT66 ---
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NF_NAT_MASQUERADE_IPV6=y

# --- Legacy 4.x compat aliases (doc lists them explicitly) ---
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV6=y

# --- Firewall inside container: UFW & fail2ban (doc Step 2, optional) ---
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# --- Execution / sandbox support ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_INOTIFY_USER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- GPU (kgsl built-in; turnip/Mesa used from container) ---
CONFIG_QCOM_KGSL=y

# --- KernelSU (in-tree drivers/kernelsu, default y; force built-in) ---
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y

# --- Power management: PM_AUTOSLEEP must be on (stock has it; VINTF checks it) ---
CONFIG_PM_AUTOSLEEP=y

# --- Crash forensics: pstore/ramoops (v18) ---
# ramoops is relocated to 0xa8800000 in crux-sm8150-overlay.dts, out of the
# pil_buffer_p1_region window that used to cause OVERLAP DETECTED.
# If the device bootloops, the first suspect is that RAM hole not being free
# at hypervisor level -- revert these five lines first.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_ZLIB_COMPRESS=y

# --- FCM3 VINTF kernel compliance (fixes boot-time "device internal problem" dialog) ---
CONFIG_AUDIT=y

# VINTF FCM5 kernel requirement: matrix demands QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y

# VINTF FCM5: matrix demands IKHEADERS=y (DISALLOW_CONFIG_IKHEADERS_IS_N)
CONFIG_IKHEADERS=y

# --- v13: stock-parity compat stubs (visible in /proc/config.gz) ---
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y